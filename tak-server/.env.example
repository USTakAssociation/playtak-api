# Copy to .env for local development. Every variable is optional; the values
# shown are the defaults unless noted.

TAK_TELNET_ADDR=:10000
TAK_WS_ADDR=:9999
TAK_HTTP_ADDR=:9998

TAK_PLAYERS_DB=/playtakdb/players.db
TAK_GAMES_DB=/playtakdb/games.db

# Go duration syntax, e.g. 90s, 2m
TAK_RECONNECT_TIMEOUT=2m

# Game update webhook target. Empty (default) disables it.
TAK_EVENT_SUBSCRIBER_URL=


# Outgoing email for registration and password resets, over TLS.
# TAK_SMTP_HOST is "host" or "host:port" (port defaults to 465).
# Empty TAK_SMTP_HOST (default) logs emails instead of sending them.
TAK_SMTP_HOST=
TAK_SMTP_USER=
TAK_SMTP_PASSWORD=
TAK_SMTP_FROM=

# Let a player stay logged in on several connections at once. When false
# (default), a new login disconnects the previous one.
TAK_ALLOW_MULTIPLE_SESSIONS=false

# debug, info, warn or error
TAK_LOG_LEVEL=info

# Shared secret for service-to-service HTTP calls (sent as
# "Authorization: Bearer <key>"), e.g. the tournament service creating seeks
# with PUT /api/v1/seeks. Empty (default) disables those endpoints.
TAK_SERVICE_API_KEY=

# Reverse proxies (comma-separated CIDRs) whose X-Real-IP / X-Forwarded-For
# headers are trusted to give the client's address. Requests from anywhere
# else use the connection address, so clients can't fake their IP.
TAK_TRUSTED_PROXIES=127.0.0.1/32,::1/128

# "username" (default) counts failed logins per username as well as per IP;
# "ip" limits per IP only.
TAK_LOGIN_LIMIT=username

# The events Google Sheet, published to the web as CSV. Defaults to the USTA
# events sheet.
#TAK_EVENTS_CSV_URL=
# Downloadable copy of the games DB, for GET /v1/games-history/db.
TAK_PUBLIC_GAMES_DB=

# Rating job (tak-server rate). The cursor defaults to previous.txt beside
# the games DB; the list is the ratings page's ratinglist.json.gz.
#TAK_RATING_CURSOR_FILE=
TAK_RATING_LIST_FILE=

# How long a disconnected player's tournament game is held open.
TAK_TOURNAMENT_RECONNECT_TIMEOUT=15m

# How long a command waits for its game before failing with NOK.
TAK_GAME_COMMAND_TIMEOUT=10s

# Finished games wait here until written to the games DB, so no result is
# lost if the database is busy or the server stops. Defaults to
# pending-game-results.jsonl beside TAK_GAMES_DB.
# TAK_PENDING_RESULTS_FILE=
